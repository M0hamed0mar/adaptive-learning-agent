# ============================================================
# Environment template for Docker.
# Copy to .env and fill in the secrets.
# ============================================================

# --- LLM Provider ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT=90
GROQ_MAX_RETRIES=5

# --- Rate Limiting ---
GROQ_MIN_REQUEST_INTERVAL=2.5
GROQ_RETRY_BACKOFF_MULTIPLIER=2.0
GROQ_RETRY_BACKOFF_MAX=60.0

# --- Application ---
APP_NAME=Adaptive Learning Agent
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
# Inside Docker, use the mounted /app/data volume.
DATABASE_URL=sqlite+aiosqlite:///./data/adaptive_learning.db

# --- Web Search ---
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-key-here
