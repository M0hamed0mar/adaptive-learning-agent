# ============================================
# LLM Provider Configuration (Groq)
# ============================================
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT=90
GROQ_MAX_RETRIES=5

# ============================================
# Groq rate-limit throttling
# ============================================
GROQ_MIN_REQUEST_INTERVAL=2.5
GROQ_RETRY_BACKOFF_MULTIPLIER=2.0
GROQ_RETRY_BACKOFF_MAX=60.0

# ============================================
# Application Settings
# ============================================
APP_NAME=Adaptive Learning Agent
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite+aiosqlite:///./data/adaptive_learning.db

# ============================================
# Web Search (Tavily)
# ============================================
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-key-here
